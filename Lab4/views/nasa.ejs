<%- include('partials/header.ejs') %>

<h1>NASA Picture of the Day</h1>
<h2><%= podTitle %></h2>

<% if (podVideo) { %>
    <video width="700" controls>
        <source src="<%= podVideo %>" type="video/mp4">
        Your browser does not support the video tag.
    </video>
<% } else if (podIframe) { %>
    <iframe
            src="<%= podIframe %>"
            width="700"
            height="400"
            allowfullscreen>
    </iframe>

    <% if (podImage) { %>
        <div style="margin-top: 20px;">
            <img src="<%= podImage %>" width="500" alt="NASA thumbnail">
        </div>
    <% } %>
<% } else if (podImage) { %>
    <img src="<%= podImage %>" width="500" alt="NASA Picture of the Day">
<% } %>

<p><%= podExplanation %></p>

<%- include('partials/footer.ejs') %>
<%- include("partials/header") %>

<div class="app-layout">
    <%- include("partials/nav") %>

    <main class="main-content">
        <div class="card p-4">
            <h1 class="mb-4">Updating & Deleting Authors</h1>

            <div class="list-group">
                <% for (let i = 0; i < authors.length; i++) { %>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong><%= authors[i].firstName %> <%= authors[i].lastName %></strong>
                        </div>
                        <div>
                            <a href="/author/edit?authorId=<%= authors[i].authorId %>" class="btn btn-sm btn-primary">Edit</a>
                            <a href="/author/delete?authorId=<%= authors[i].authorId %>" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <%- include("partials/footer") %>
    </main>
</div>
<%- include("partials/header") %>

<div class="app-layout">
    <%- include("partials/nav") %>

    <main class="main-content">
        <div class="card p-4">
            <h1 class="mb-4">Updating Author Data</h1>

            <form method="POST" action="/author/edit" class="row g-3">
                <input type="hidden" name="authorId" value="<%= authorInfo[0].authorId %>">

                <div class="col-md-6">
                    <label class="form-label">First Name</label>
                    <input type="text" name="fName" class="form-control" value="<%= authorInfo[0].firstName %>" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Last Name</label>
                    <input type="text" name="lName" class="form-control" value="<%= authorInfo[0].lastName %>" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Date of Birth</label>
                    <input type="date" name="dob" class="form-control" value="<%= authorInfo[0].dobISO %>" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Date of Death</label>
                    <input type="date" name="dod" class="form-control" value="<%= authorInfo[0].dodISO || '' %>">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Sex</label>
                    <select name="sex" class="form-select" required>
                        <option value="M" <%= authorInfo[0].sex === "M" ? "selected" : "" %>>Male</option>
                        <option value="F" <%= authorInfo[0].sex === "F" ? "selected" : "" %>>Female</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Profession</label>
                    <input type="text" name="profession" class="form-control" value="<%= authorInfo[0].profession %>" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Country</label>
                    <input type="text" name="country" class="form-control" value="<%= authorInfo[0].country %>" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Portrait URL</label>
                    <input type="text" name="portrait" class="form-control" value="<%= authorInfo[0].portrait %>" required>
                </div>

                <div class="col-12">
                    <label class="form-label">Biography</label>
                    <textarea name="biography" rows="5" class="form-control" required><%= authorInfo[0].biography %></textarea>
                </div>

                <div class="col-12">
                    <button class="btn btn-primary">Update Author</button>
                </div>
            </form>
        </div>

        <%- include("partials/footer") %>
    </main>
</div>

</body>
</html>